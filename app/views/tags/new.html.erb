<% title "New Tag | Polybank" %>

<h2 class="font-bold text-2xl mb-3">New Tag</h2>

<%= form_with model: Tag.new do |form| %>
  <div class="card">
    <div class="flex flex-col gap-2 items-start">
      <div class="flex flex-col">
        <%= form.label :name, "Name" %>
        <%= form.text_field :name, class: "bg-white rounded-md text-black" %>
      </div>

      <div class="flex flex-col">
        <%= form.label :color, "Color" %>
        <%= form.text_field :color, class: "bg-white rounded-md text-black" %>
      </div>

      <%= form.submit "Create", class: "cursor-pointer" %>
    </div>
  </div>
<% end %>