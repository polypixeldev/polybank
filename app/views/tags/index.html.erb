<% title "Tags" %>

<div class="flex gap-3 mb-3">
  <h2 class="font-bold text-2xl">Tag Search</h2>

  <%= link_to "New", new_tag_path, class: "inline-btn" %>
</div>

<%= form_with url: tags_path, method: :get do |form| %>
  <div class="card">
    <div class="flex gap-2">
      <%= form.text_field :query, value: @query, class: "bg-white rounded-md text-black" %>
      <%= form.submit "Search", class: "cursor-pointer" %>
    </div>
  </div>
<% end %>

<div class="flex gap-5">
  <div class="card">
    <p>Total amount</p>

    <p class="card-headline"><%= number_to_currency @total_amount %></p>
  </div>
</div>

<p class="mb-2 mt-5 font-bold text-xl">Tags</p>

<div class="flex flex-col gap-2 bg-slate-900 p-2 rounded-md">
  <% if @tags.any? %>
    <% @tags.each do |tag| %>
      <%= render partial: "tags/tag_row", locals: { tag: } %>
    <% end %>
  <% else %>
    <p>No results</p>
  <% end %>
</div>
