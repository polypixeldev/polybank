<%# locals: (tag:, transaction: nil) %>

<div class="py-2 px-3 rounded-full flex gap-2" style="background-color: <%= tag.color %>">
  <% if transaction.present? %>
    <%= link_to tag_path(tag), class: "cursor-pointer" do %>
      <p><%= tag.name %></p>
    <% end %>

    <%= button_to "X", toggle_tag_transaction_path(transaction, tag_id: tag.id), class: "cursor-pointer" %>
  <% else %>
    <p><%= tag.name %></p>
  <% end %>
</div>