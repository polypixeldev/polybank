<%# locals: (tag: nil, attach: nil) %>

<%= form_with model: tag || Tag.new do |form| %>
  <%= form.hidden_field :attach, value: attach %>

  <div class="card">
    <div class="flex flex-col gap-2 items-start">
      <div class="flex flex-col">
        <%= form.label :name, "Name" %>
        <%= form.text_field :name, class: "bg-white rounded-md text-black p-1" %>
      </div>

      <div class="flex flex-col">
        <%= form.label :color, "Color (hex)" %>
        <%= form.text_field :color, class: "bg-white rounded-md text-black p-1" %>
      </div>

      <%= form.submit tag.nil? ? "Create" : "Save", class: "btn" %>
    </div>
  </div>
<% end %>
