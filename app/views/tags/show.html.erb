<% title @tag.name %>

<div class="flex gap-2 items-center mb-3">
  <div class="rounded-full w-5 h-5" style="background-color: <%= @tag.color %>"></div>
  <h2 class="font-bold text-2xl"><%= @tag.name %></h2>

  <%= link_to "Edit", edit_tag_path(@tag), class: "inline-btn" %>
  <%= button_to "Delete",
                tag_path(@tag),
                method: :delete,
                class: "inline-btn",
                data: { "turbo-confirm": "Are you sure you want to delete this tag?" } %>
</div>

<%= turbo_frame_tag :transactions_list, src: list_transactions_path(show_filters: true, tag_id: @tag.id) do %>
  <p>Loading transactions...</p>
<% end %>
