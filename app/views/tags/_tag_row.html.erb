<%# locals: (tag:) %>

<% sum = tag.amount %>

<%= link_to tag_path(tag), class: "grid grid-cols-15 px-4 py-3 bg-slate-800 rounded-md items-center" do %>
  <div class="rounded-full w-5 h-5" style="background-color: <%= tag.color %>"></div>
  <p class="col-span-13"><%= tag.name %></p>
  <p class="justify-self-end <%= sum < 0 ? "text-red-500" : "text-green-500" %>"><%= number_to_currency sum %></p>
<% end %>