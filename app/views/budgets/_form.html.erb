<%# locals: (budget: nil) %>

<%= form_with model: budget || Budget.new do |form| %>
  <div class="card flex flex-col gap-2 items-start">
    <div class="flex flex-col">
      <%= form.label :name, "Name" %>
      <%= form.text_field :name, class: "bg-white rounded-md text-black p-1" %>
    </div>

    <div class="flex flex-col">
      <%= form.label :period, "Period" %>
      <%= form.select :period, Budget.periods.keys.map { |p| [ p.humanize, p ] }, {}, class: "bg-white rounded-md text-black p-1" %>
    </div>

    <div class="flex flex-col">
      <%= form.label :limit_amount, "Limit" %>
      <%= form.number_field :limit_amount, step: 0.01, min: 0, class: "bg-white rounded-md text-black p-1" %>
    </div>

    <div class="flex flex-col">
      <%= form.label :target, "Target" %>
      <%= form.collection_select :target_gid, Budgetable.available_budgetables(current_user), :to_global_id, :to_s, {}, class: "bg-white rounded-md text-black p-1" %>
    </div>

    <div class="flex flex-col">
      <%= form.label :active do %>
        <%= form.check_box :active %>
        Active
      <% end %>
    </div>

    <%= form.submit "Create", class: "btn" %>
  </div>
<% end %>