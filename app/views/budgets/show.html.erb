<% title @budget.name %>

<div class="flex gap-2 items-center mb-3">
  <h2 class="font-bold text-2xl"><%= @budget.name %></h2>

  <%= link_to "Edit", edit_budget_path(@budget), class: "inline-btn" %>
  <%= button_to "Delete",
                budget_path(@budget),
                method: :delete,
                class: "inline-btn",
                data: { turbo_confirm: "Are you sure you want to delete this budget?" } %>
</div>

<div class="flex gap-5 mb-5">
  <div class="card">
    <p>Status</p>
    <p class="card-headline"><%= @budget.status_text %></p>
  </div>

  <div class="card">
    <p><%= @budget.target_type.humanize %></p>
    <p class="card-headline"><%= link_to @budget.target.display_name, @budget.target %></p>
  </div>

  <div class="card">
    <p>Period</p>
    <p class="card-headline"><%= @budget.period.humanize %></p>
  </div>

  <div class="card">
    <p>Limit</p>
    <p class="card-headline"><%= number_to_currency @budget.limit_amount %></p>
  </div>

  <div class="card">
    <p>Remaining</p>
    <p class="card-headline"><%= number_to_currency @budget.remaining_amount_in_period %></p>
  </div>
</div>

<%= turbo_frame_tag :transactions_list,
                    src: list_transactions_path({
                      show_filters: false,
                      account_id: @budget.target_type == "Account" ? @budget.target_id : nil,
                      category_id: @budget.target_type == "Category" ? @budget.target_id : nil,
                      counterparty_id: @budget.target_type == "Counterparty" ? @budget.target_id : nil,
                      tag_id: @budget.target_type == "Tag" ? @budget.target_id : nil,
                      start_date: @budget.period_start_date(Date.today),
                      end_date: @budget.period_end_date(Date.today)
                    }.compact) do %>
  <p>Loading transactions...</p>
<% end %>

<h3 class="mt-3 mb-2 font-bold text-2xl">History</h3>

<% if @recent_periods.any? %>
  <div class="flex flex-col gap-3">
    <% @recent_periods.each do |period_range| %>
      <%= render partial: "budgets/budget_period", locals: { budget: @budget, period: period_range } %>
    <% end %>
  </div>
<% else %>
  <p>No history yet</p>
<% end %>
