<%# locals: (view:) %>

<%= link_to view_path(view), class: "grid grid-cols-15 px-4 py-3 bg-slate-800 rounded-md items-center" do %>
  <p class="col-span-11"><%= view.name %></p>
  <p class="col-span-4 justify-self-end <%= view.amount > 0 ? "text-green-500" : "text-red-500" %>"><%= number_to_currency view.amount %></p>
<% end %>
