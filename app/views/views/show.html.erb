<% title @view.name %>

<%= turbo_frame_tag :share_content, target: "_top" do %>
  <div class="flex gap-2 items-center mb-3">
    <h2 class="font-bold text-2xl"><%= @view.name %></h2>

    <% if policy(@view).update? %>
      <%= link_to "Edit", edit_view_path(@view), class: "inline-btn" %>
      <%= button_to "Delete",
                    view_path(@view),
                    method: :delete,
                    class: "inline-btn",
                    data: {
                      turbo_confirm: "Are you sure you want to delete this view?"
                    } %>
    <% end %>
  </div>

  <div class="flex flex-col gap-2 bg-slate-900 p-2 rounded-md mt-3">
    <%= render partial: "transactions/transaction", collection: @transactions %>
  </div>
<% end %>
