<% title @view.name %>

<div class="flex gap-2 items-center mb-3">
  <h2 class="font-bold text-2xl"><%= @view.name %></h2>

  <%= link_to "Edit", edit_view_path(@view), class: "inline-btn" %>
  <%= button_to "Delete", view_path(@view), method: :delete, class: "inline-btn", data: { turbo_confirm: "Are you sure you want to delete this view?" } %>
</div>

<%= turbo_frame_tag :transactions_list, src: list_transactions_path({
                                                                      show_filters: true,
                                                                      disable_filters: true,
                                                                      query: @view.memo,
                                                                      start_date: @view.start_date,
                                                                      end_date: @view.end_date,
                                                                      account_id: @view.account_id,
                                                                      category_id: @view.category_id,
                                                                      counterparty_id: @view.counterparty_id,
                                                                      tag_id: @view.tag_id,
                                                                      min_amount: @view.min_amount,
                                                                      max_amount: @view.max_amount,
                                                                      direction: @view.direction
                                                                    }.compact) %>
