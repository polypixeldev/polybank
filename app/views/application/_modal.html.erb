<turbo-frame id="modal">
  <div role="dialog" tabindex="-1" data-controller="modal" data-action="turbo:submit-end->modal#hideOnSubmit keydown.esc->modal#hide" role="dialog" tabindex="-1" class="fixed inset-0 z-30 flex items-center justify-center w-full h-screen p-2">
    <%= button_to nil, nil, type: :button, method: :get, form: { data: {action: "modal#hide"} }, class: "fixed inset-0 block w-full h-screen cursor-default bg-gray-900/30" %>

    <div class="relative z-20 w-full max-w-2xl max-h-screen overflow-y-auto bg-gray-950 p-5 shadow-lg rounded-md">
      <%= yield %>
    </div>
  </div>
</turbo-frame>
