<%= turbo_frame_tag "comment_#{@comment.id}" do %>
  <div class="card">
    <p class="font-bold">Edit comment</p>

    <%= form_with model: @comment, class: "flex flex-col items-start gap-1" do |form| %>
      <%= form.text_field :content, class: "bg-white rounded-md text-black p-1" %>
      <%= form.file_field :attachment %>

      <%= form.submit "Save", class: "btn" %>
    <% end %>
  </div>
<% end %>
