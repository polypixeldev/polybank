<%# locals: (transaction:, reimburse_transaction_id: nil) %>

<% content = capture do %>
  <% if transaction.plaid_object&.[]("logo_url").present? %>
    <img src="<%= transaction.plaid_object["logo_url"] %>" class="w-8 h-8 rounded-sm">
  <% else %>
    <p></p>
  <% end %>
  <p class="col-span-3 md:col-span-1"><%= transaction.date.to_fs(:long) %></p>
  <p class="col-span-4 md:col-span-7 truncate"><%= transaction.memo %></p>
  <p
    class="<%= class_names(
                 "justify-self-end col-span-2 md:col-span-1",
                 "text-red-500" => transaction.amount_cents.negative?,
                 "text-green-500" => transaction.amount_cents.positive?
               ) %>">
    <%= number_to_currency transaction.amount %>
  </p>
<% end %>

<% if reimburse_transaction_id.present? %>
  <%= button_to mark_reimbursed_transaction_path(
        id: reimburse_transaction_id,
        reimbursing_transaction_id: transaction.id
      ),
                class: class_names(
                  "grid grid-cols-10 justify-between px-4 py-3 bg-slate-800 rounded-md",
                  "border-orange-500 border-2" => transaction.pending
                ),
                data: { turbo_frame: "_top" } do %>
    <%= content %>
  <% end %>
<% elsif policy(transaction).show? %>
  <%= link_to transaction_path(transaction),
              class: class_names(
                "grid grid-cols-10 justify-between px-4 py-3 bg-slate-800 rounded-md",
                "border-orange-500 border-2" => transaction.pending
              ),
              data: { turbo_frame: "_top" } do %>
    <%= content %>
  <% end %>
<% else %>
  <div class="<%= class_names(
                    "grid grid-cols-10 justify-between px-4 py-3 bg-slate-800 rounded-md",
                    "border-orange-500 border-2" => transaction.pending
                  ) %>">
    <%= content %>
  </div>
<% end %>
