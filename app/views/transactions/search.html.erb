<% title "Transactions | Polybank" %>

<h2 class="font-bold text-2xl mb-3">Transaction Search</h2>

<%= form_with url: search_transactions_path, method: :get do |form| %>
  <div class="card">
    <div class="flex gap-2">
      <%= form.text_field :query, value: @query, class: "bg-white rounded-md text-black" %>
      <%= form.submit "Search", class: "cursor-pointer" %>
    </div>
  </div>
<% end %>

<% if defined?(@transactions) %>
  <div class="flex gap-5">
    <div class="card">
      <p>Total amount</p>

      <p class="card-headline"><%= number_to_currency @total_amount %></p>
    </div>
  </div>

  <div class="flex flex-col gap-2 bg-slate-900 p-2 rounded-md mt-3">
    <p class="mb-2 font-bold text-xl">Transactions</p>

    <% if @transactions.any? %>
      <% @transactions.each do |transaction| %>
        <%= render partial: "transactions/transaction", locals: { transaction: transaction } %>
      <% end %>
    <% else %>
      <p>No results</p>
    <% end %>
  </div>
<% end %>