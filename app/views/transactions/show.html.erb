<% title "#{@transaction.memo} | Polybank" %>

<p class="text-sm text-gray-100"><%= link_to @transaction.account.name, account_path(@transaction.account) %></p>

<%= turbo_frame_tag "#{@transaction.id}_edit_memo" do %>
  <div class="flex gap-2">
    <h2 class="font-bold text-2xl mb-3"><%= "PENDING: " if @transaction.pending %> <%= @transaction.memo %></h2>

    <%= link_to edit_memo_transaction_path(@transaction), class: "cursor-pointer" do %>
      <%= inline_icon :edit, size: 32 %>
    <% end %>
  </div>
<% end %>

<div class="flex gap-5">
  <div class="card">
    <p>Amount</p>
    <p class="card-headline"><%= number_to_currency @transaction.amount %></p>
  </div>

  <div class="card">
    <p>Date</p>
    <p class="card-headline"><%= local_date @transaction.display_date %></p>
  </div>

  <% if @transaction.category.present? %>
    <div class="card">
      <p>Category</p>

      <%= turbo_frame_tag "#{@transaction.id}_edit_category" do %>
        <div class="flex mt-3">
          <p class="card-headline mt-0!"><%= link_to @transaction.category.display_name, category_path(@transaction.category) %></p>

          <%= link_to edit_category_transaction_path, class: "cursor-pointer" do %>
            <%= inline_icon :edit, size: 32 %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="card">
    <p>Payment channel</p>
    <p class="card-headline"><%= @transaction.plaid_object["payment_channel"].humanize %></p>
  </div>

  <% if @transaction.plaid_object["check_number"].present? %>
    <div class="card">
      <p>Check #</p>
      <p class="card-headline"><%= transaction.plaid_object[:check_number] %></p>
    </div>
  <% end %>

  <% @transaction.counterparties.each do |party| %>
    <div class="card">
      <p><%= party.counterparty_type.humanize %></p>
      <div class="flex gap-2 items-center mt-3">
        <% if party.logo_url.present? %>
          <img src="<%= party.logo_url %>" class="w-8 h-8 rounded-sm">
        <% end %>
        <p class="card-headline mt-0!">
          <%= link_to party.name, counterparty_path(party) %>
        </p>
      </div>
    </div>
  <% end %>

  <div class="card">
    <p class="mb-2">Tags</p>
    
    <% @transaction.tags.each do |tag| %>
      <span class="p-1 rounded-full" style="background-color: <%= tag.color %>"><%= tag.name %></span>
    <% end %>

    <%= link_to "Add", add_tag_modal_transaction_path(@transaction), class: "bg-gray-800 py-1 px-3 rounded-full", data: {turbo_frame: "modal"} %>
  </div>
</div>

<% if @transaction.pending_transaction.present? %>
  <div class="mb-3 mt-5 flex gap-2">
    <h3 class="font-bold text-xl">Pending transaction</h3>
    <%= link_to @transaction.pending_transaction do %>
      <%= inline_icon :link, size: 32 %>
    <% end %>
  </div>

  <div class="flex gap-5">
    <div class="card">
      <p>Amount</p>
      <p class="card-headline"><%= number_to_currency @transaction.amount %></p>
    </div>

    <div class="card">
      <p>Date</p>
      <p class="card-headline"><%= local_date @transaction.display_date %></p>
    </div>
  </div>
<% end %>

<% if @transaction.settled_transaction.present? %>
  <div class="mb-3 mt-5 flex gap-2">
    <h3 class="font-bold text-xl">Settled transaction</h3>
    <%= link_to @transaction.settled_transaction do %>
      <%= inline_icon :link, size: 32 %>
    <% end %>
  </div>
<% end %>

