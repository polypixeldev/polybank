<%= form_with url: list_transactions_path, method: :get, class: "flex gap-5 flex-wrap" do |form| %>
  <%= form.hidden_field :show_filters, value: @show_filters %>

  <div class="card">
    <div class="flex flex-col gap-2">
      <%= form.label :query, "Memo" %>
      <%= form.text_field :query, value: @query, class: "bg-white rounded-md text-black" %>
    </div>
  </div>

  <div class="card">
    <div class="flex flex-col gap-2">
      <%= form.label :start_date, "Start date" %>
      <%= form.date_field :start_date, value: @start_date, class: "bg-white rounded-md text-black" %>
    </div>
  </div>

  <div class="card">
    <div class="flex flex-col gap-2">
      <%= form.label :end_date, "End date" %>
      <%= form.date_field :end_date, value: @end_date, class: "bg-white rounded-md text-black" %>
    </div>
  </div>

  <div class="card">
    <div class="flex flex-col gap-2">
      <%= form.label :category_id, "Category" %>
      <%= form.collection_select :category_id, current_user.categories.order(:name), :id, :display_name, { selected: @category&.id, include_blank: "All" }, class: "bg-white rounded-md text-black" %>
    </div>
  </div>

  <div class="card">
    <div class="flex flex-col gap-2">
      <%= form.label :counterparty_id, "Counterparty" %>
      <%= form.collection_select :counterparty_id, current_user.counterparties.order(custom_name: :asc, plaid_name: :asc), :id, :name, { selected: @counterparty&.id, include_blank: "All" }, class: "bg-white rounded-md text-black" %>
    </div>
  </div>

  <div class="card">
    <div class="flex flex-col gap-2">
      <%= form.label :tag_id, "Tag" %>
      <%= form.collection_select :tag_id, current_user.tags.order(name: :asc), :id, :name, { selected: @tag&.id, include_blank: "All" }, class: "bg-white rounded-md text-black" %>
    </div>
  </div>

  <div class="card">
    <div class="flex flex-col gap-2">
      <%= form.label :min_amount, "Min amount" %>
      <%= form.number_field :min_amount, value: @min_amount, class: "bg-white rounded-md text-black" %>
    </div>
  </div>

  <div class="card">
    <div class="flex flex-col gap-2">
      <%= form.label :max_amount, "Max amount" %>
      <%= form.number_field :max_amount, value: @max_amount, class: "bg-white rounded-md text-black" %>
    </div>
  </div>

  <div class="card">
    <div class="flex flex-col gap-2">
      <%= form.label :direction, "Direction" %>
      <%= form.select :direction, [["Incoming", "incoming"], ["Outgoing", "outgoing"]], { selected: @direction, include_blank: "Both" }, class: "bg-white rounded-md text-black" %>
    </div>
  </div>

  <div class="card justify-center">
    <%= form.submit "Search", class: "cursor-pointer" %>
  </div>
<% end %>