<% title "Transactions | Polybank" %>

<h2 class="font-bold text-2xl mb-3">Transaction Search</h2>

<%= form_with url: transactions_path, method: :get, class: "flex gap-5" do |form| %>
  <div class="card">
    <div class="flex flex-col gap-2">
      <%= form.label :query, "Memo" %>
      <%= form.text_field :query, value: @query, class: "bg-white rounded-md text-black" %>
    </div>
  </div>

  <div class="card">
    <div class="flex flex-col gap-2">
      <%= form.label :start_date, "Start date" %>
      <%= form.date_field :start_date, value: @start_date, class: "bg-white rounded-md text-black" %>
    </div>
  </div>

  <div class="card">
    <div class="flex flex-col gap-2">
      <%= form.label :end_date, "End date" %>
      <%= form.date_field :end_date, value: @end_date, class: "bg-white rounded-md text-black" %>
    </div>
  </div>

  <div class="card">
    <div class="flex flex-col gap-2">
      <%= form.label :category_id, "Category" %>
      <%= form.collection_select :category_id, current_user.categories.order(:name), :id, :display_name, { value: @category&.id }, class: "bg-white rounded-md text-black" %>
    </div>
  </div>

  <div class="card justify-center">
    <%= form.submit "Search", class: "cursor-pointer" %>
  </div>
<% end %>

<div class="flex gap-5">
  <div class="card">
    <p>Total amount</p>

    <p class="card-headline"><%= number_to_currency @total_amount %></p>
  </div>
</div>

<div class="flex flex-col gap-2 bg-slate-900 p-2 rounded-md mt-3">
  <p class="mb-2 font-bold text-xl">Transactions</p>

  <% if @transactions.any? %>
    <% @transactions.each do |transaction| %>
      <%= render partial: "transactions/transaction", locals: { transaction: transaction } %>
    <% end %>
  <% else %>
    <p>No results</p>
  <% end %>
</div>