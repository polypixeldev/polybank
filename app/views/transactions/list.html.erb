<%= turbo_frame_tag :transactions_list do %>
  <%= render partial: "transactions/search_bar" if @show_filters %>

  <div class="flex justify-between items-center mb-2 mt-5">
    <h3 class="font-bold text-xl">Transactions</h3>

    <p class="my-0 mr-1">Total: <%= number_to_currency @total_amount %></p>
  </div>

  <div class="flex flex-col gap-2 bg-slate-900 p-2 rounded-md mt-3">
    <% if @transactions.any? %>
      <% @transactions.each do |transaction| %>
        <%= render partial: "transactions/transaction", locals: { transaction: transaction, reimburse_transaction_id: @reimburse_transaction_id } %>
      <% end %>
    <% else %>
      <p>No results</p>
    <% end %>
  </div>
<% end %>