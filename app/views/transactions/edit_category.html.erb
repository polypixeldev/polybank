<%= turbo_frame_tag "#{@transaction.id}_edit_category" do %>
  <%= form_with model: @transaction, method: :put do |form| %>
    <%= form.collection_select :category_id, Category.order(custom_name: :asc, plaid_name: :asc), :id, :display_name, {}, class: "bg-white rounded-md px-2 py-1 my-1 text-black" %>
    <%= form.submit "Save" %>
  <% end %>
<% end %>
