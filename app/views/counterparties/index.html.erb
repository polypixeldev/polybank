<% title "Counterparties" %>

<h2 class="font-bold text-2xl mb-3">Counterparties</h2>

<%= form_with url: counterparties_path, method: :get do |form| %>
  <div class="card">
    <div class="flex gap-2">
      <%= form.text_field :query, value: @query, class: "bg-white rounded-md text-black" %>
      <%= form.submit "Search", class: "cursor-pointer" %>
    </div>
  </div>
<% end %>

<div class="flex gap-5">
  <div class="card">
    <p>Total amount</p>

    <p class="card-headline"><%= number_to_currency @total_amount %></p>
  </div>
</div>

<p class="mb-2 mt-5 font-bold text-xl">Counterparties</p>

<div class="flex flex-col gap-2 bg-slate-900 p-2 rounded-md">
  <% if @counterparties.any? %>
    <% @counterparties.each do |counterparty| %>
      <%= render partial: "counterparties/counterparty", locals: { counterparty: counterparty } %>
    <% end %>
  <% else %>
    <p>No results</p>
  <% end %>
</div>
