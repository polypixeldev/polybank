<% title @counterparty.name %>

<%= turbo_frame_tag "#{@counterparty.id}_edit_name" do %>
  <div class="flex gap-2">
    <h2 class="font-bold text-2xl mb-3"><%= @counterparty.name %></h2>

    <%= link_to edit_name_counterparty_path(@counterparty), class: "cursor-pointer" do %>
      <%= inline_icon :edit, size: 32 %>
    <% end %>
  </div>
<% end %>

<%= turbo_frame_tag :transactions_list,
                    src: list_transactions_path(show_filters: true, counterparty_id: @counterparty.id) do %>
  <p>Loading transactions...</p>
<% end %>
