<% title "#{@counterparty.name} | Polybank" %>

<%= turbo_frame_tag "#{@counterparty.id}_edit_name" do %>
  <div class="flex gap-2">
    <h2 class="font-bold text-2xl mb-3"><%= @counterparty.name %></h2>

    <%= link_to edit_name_counterparty_path(@counterparty), class: "cursor-pointer" do %>
      <%= inline_icon :edit, size: 32 %>
    <% end %>
  </div>
<% end %>

<div class="flex gap-5">
  <div class="card">
    <p>Total amount</p>
    <p class="card-headline"><%= number_to_currency @total_amount %></p>
  </div>
</div>

<h3 class="text-xl mt-5 mb-2">Transactions</h3>

<div class="flex flex-col gap-2 bg-slate-900 p-2 rounded-md">
  <% @counterparty.transactions.order(pending: :desc, date: :desc).each do |txn| %>
    <%= render partial: "transactions/transaction", locals: { transaction: txn } %>
  <% end %>
</div>