<%# locals: (counterparty:) %>

<%= link_to counterparty_path(counterparty), class: "grid grid-cols-15 px-4 py-3 bg-slate-800 rounded-md" do %>
  <% if counterparty["logo_url"].present? %>
    <img src="<%= counterparty["logo_url"] %>" class="w-8 h-8 rounded-sm">
  <% else %>
    <p></p>
  <% end %>
  <p class="col-span-14"><%= counterparty.name %></p>
<% end %>