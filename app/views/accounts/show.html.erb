<% title @account.name %>

<% if @account.plaid_item.present? %>
  <div class="flex flex-row gap-2">
    <p class="text-gray-100"><%= @account.plaid_item.name %></p>
    <%= button_to "(Sync)", sync_plaid_item_path(@account.plaid_item), class: "cursor-pointer" %>
    <%= button_to "(Refresh)", refresh_plaid_item_path(@account.plaid_item), class: "cursor-pointer" %>
  </div>
<% end %>

<h2 class="font-bold text-2xl mb-3"><%= @account.name %></h2>

<div class="flex flex-col items-center gap-5">
  <div class="card w-full!">
    <p class="text-sm text-gray-100 mb-0">Balance</p>
    <p class="card-headline mt-0!"><%= number_to_currency @account.balance %></p>
  </div>

  <%= line_chart @account.balance_by_day, height: "300px" %>
</div>

<h3 class="text-xl font-semibold mt-5 mb-2">Transactions</h3>

<div class="flex flex-col gap-2 bg-slate-900 p-2 rounded-md">
  <% @account.transactions.effective.order(pending: :desc, date: :desc).each do |txn| %>
    <%= render partial: "transactions/transaction", locals: { transaction: txn } %>
  <% end %>
</div>
