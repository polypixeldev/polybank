<%= turbo_frame_tag :graphs do %>
  <%= form_with url: graphs_path, method: :get, class: "flex gap-5", data: { turbo_frame: "graphs" } do |form| %>
    <div class="card">
      <div class="flex flex-col gap-2">
        <%= form.label :time_frame, "Time frame" %>
        <%= form.select :time_frame, [["Week", "week"], ["Month", "month"], ["Year", "year"]], { selected: @time_frame, include_blank: "All" }, class: "bg-white rounded-md text-black p-1", onchange: "this.form.submit()" %>
      </div>
    </div>

    <%= form.submit "Export", formaction: export_transactions_path,
                            formmethod: :post,
                            class: "card justify-center! cursor-pointer", data: { turbo: false } %>
  <% end %>

  <p class="font-bold text-lg text-center">Money Flow</p>

  <%= sankey_chart({
    data: @categories.map { |c| { name: c.display_name } } + @categories.map { |c| { name: "#{c.display_name} " } } + [{ name: "Bank" }],
    links: @income_by_category.to_a.map { |c| { source: c[0], target: "Bank", value: c[1].abs } } + @expenses_by_category.to_a.map { |c| { target: "#{c[0]} ", source: "Bank", value: c[1].abs } }
  }, { theme: "dark", options: { tooltip: { trigger: "item", triggerOn: "mousemove", valueFormatter: RailsCharts.js("(value) => '$' + value") } } }) %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-20 mt-10">
    <div>
      <p class="font-bold text-lg text-center">Income by category</p>
      <%= pie_chart @income_by_category, round: 2, zeros: true %>
    </div>

    <div>
      <p class="font-bold text-lg text-center">Expenses by category</p>
      <%= pie_chart @expenses_by_category, round: 2, zeros: true %>
    </div>

    <div>
      <p class="font-bold text-lg text-center">Income by counterparty</p>
      <%= pie_chart @income_by_counterparty, round: 2, zeros: true %>
    </div>

    <div>
      <p class="font-bold text-lg text-center">Expenses by counterparty</p>
      <%= pie_chart @expenses_by_counterparty, round: 2, zeros: true %>
    </div>

    <div>
      <p class="font-bold text-lg text-center">Income by tag</p>
      <%= pie_chart @income_by_tag, round: 2, zeros: true %>
    </div>

    <div>
      <p class="font-bold text-lg text-center">Expenses by tag</p>
      <%= pie_chart @expenses_by_tag, round: 2, zeros: true %>
    </div>
  </div>
<% end %>